# Copy to .env and fill in what applies. Everything is optional.

PORT=4319
# Use 0.0.0.0 to reach the scanner from other machines on the LAN.
HOST=127.0.0.1
SCAN_INTERVAL_MIN=5
# SCAN_INTERFACE=en0

# UniFi (UDM, UCG, Cloud Key, or self-hosted Network app). Use a local admin account, not a UI.com SSO login.
# UNIFI_URL=https://192.168.1.1
# UNIFI_USERNAME=
# UNIFI_PASSWORD=
# UNIFI_SITE=default
# Set to false for the self-hosted Network app (no /proxy/network prefix).
# UNIFI_OS=true

# OpenWrt with LuCI.
# OPENWRT_URL=http://192.168.1.1
# OPENWRT_USERNAME=root
# OPENWRT_PASSWORD=
